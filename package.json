{
  "name": "mailshield-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --require ./tests/node-user-shim.cjs --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "evaluate": "tsx scripts/evaluate.ts",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "google-auth-library": "^11.1.0",
    "googleapis": "^182.0.0",
    "html-to-text": "^10.0.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "postal-mime": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
